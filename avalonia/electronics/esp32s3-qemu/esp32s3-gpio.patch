diff --git a/hw/adc/esp32s3_adc.c b/hw/adc/esp32s3_adc.c
new file mode 100644
index 0000000..92b7264
--- /dev/null
+++ b/hw/adc/esp32s3_adc.c
@@ -0,0 +1,181 @@
+/*
+ * ESP32-S3 RTC SAR ADC single-shot controller.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/adc/esp32s3_adc.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+#include "qemu/bitops.h"
+#include "qemu/cutils.h"
+#include "qemu/module.h"
+
+enum {
+    READER1 = 0x00, READER1_STATUS = 0x04, MEASURE1 = 0x0c,
+    ADC1_MUX = 0x10, ATTEN1 = 0x14,
+    READER2 = 0x24, READER2_STATUS = 0x28, MEASURE2 = 0x30,
+    ATTEN2 = 0x38, SLAVE_ADDRESS1 = 0x40,
+};
+
+#define PAD_FORCE BIT(31)
+#define START_FORCE BIT(18)
+#define START BIT(17)
+#define DONE BIT(16)
+#define MEASURE_WRITE_MASK (PAD_FORCE | (0xfffu << 19) | START_FORCE | START)
+#define ADC_MAX 4095
+
+static uint32_t convert(ESP32S3ADCState *s, int unit, uint32_t control)
+{
+    static const int full_scale_uv[] = { 950000, 1250000, 1750000, 3100000 };
+    unsigned pads = extract32(control, 19, 12);
+    int channel;
+    int voltage;
+    int scale;
+    uint32_t raw;
+
+    /* RTC self-calibration selects internal ground with all pads disabled. */
+    if (!(control & PAD_FORCE) || !pads || (pads & (pads - 1))) {
+        return 0;
+    }
+    channel = ctz32(pads);
+    if (channel >= ESP32S3_ADC_CHANNELS) {
+        return 0;
+    }
+    voltage = s->microvolts[unit * ESP32S3_ADC_CHANNELS + channel];
+    scale = full_scale_uv[extract32(s->registers[(unit ? ATTEN2 : ATTEN1) / 4],
+                                    channel * 2, 2)];
+    raw = ((uint64_t)MIN(voltage, scale) * ADC_MAX + scale / 2) / scale;
+    if (s->registers[(unit ? READER2 : READER1) / 4] & BIT(unit ? 29 : 28)) {
+        raw ^= ADC_MAX;
+    }
+    return raw;
+}
+
+static uint64_t sens_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3ADCState *s = opaque;
+    return s->registers[addr / 4];
+}
+
+static void sens_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    ESP32S3ADCState *s = opaque;
+    uint32_t *reg = &s->registers[addr / 4];
+
+    switch (addr) {
+    case MEASURE1:
+    case MEASURE2: {
+        int unit = addr == MEASURE2;
+        uint32_t previous = *reg;
+
+        *reg = (val & MEASURE_WRITE_MASK) | (previous & (DONE - 1));
+        if ((val & (START | START_FORCE)) != (START | START_FORCE)) {
+            break;
+        }
+        if (!unit && (s->registers[ADC1_MUX / 4] & BIT(31))) {
+            break;
+        }
+        *reg |= (previous & START) ? (previous & DONE) : DONE;
+        if (!(previous & START)) {
+            *reg = (*reg & ~(DONE - 1)) | convert(s, unit, val);
+        }
+        break;
+    }
+    case READER1_STATUS:
+    case READER2_STATUS:
+        break;
+    case SLAVE_ADDRESS1:
+        *reg = val & 0x003fffff; /* RTC controller is idle between conversions. */
+        break;
+    default:
+        *reg = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps sens_ops = {
+    .read = sens_read,
+    .write = sens_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void adc_input(void *opaque, int index, int microvolts)
+{
+    ESP32S3ADCState *s = opaque;
+    s->microvolts[index] = MIN(MAX(microvolts, 0), 3600000);
+}
+
+static void adc_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3ADCState *s = ESP32S3_ADC(obj);
+    memset(s->registers, 0, sizeof(s->registers));
+    s->registers[READER1 / 4] = BIT(18) | 2;
+    s->registers[READER2 / 4] = BIT(18) | 2;
+    s->registers[ATTEN1 / 4] = UINT32_MAX;
+    s->registers[ATTEN2 / 4] = UINT32_MAX;
+}
+
+static void adc_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3ADCState *s = ESP32S3_ADC(dev);
+    g_auto(GStrv) values = NULL;
+
+    if (!s->initial_uv) {
+        return;
+    }
+    values = g_strsplit(s->initial_uv, ":", G_N_ELEMENTS(s->microvolts) + 1);
+    if (g_strv_length(values) != G_N_ELEMENTS(s->microvolts)) {
+        error_setg(errp, "ESP32-S3 ADC needs one initial voltage per pad");
+        return;
+    }
+    for (int i = 0; i < G_N_ELEMENTS(s->microvolts); i++) {
+        int value;
+
+        if (qemu_strtoi(values[i], NULL, 10, &value) < 0 ||
+            value < 0 || value > 3600000) {
+            error_setg(errp, "ESP32-S3 ADC initial voltage outside 0-3600000 uV");
+            return;
+        }
+        s->microvolts[i] = value;
+    }
+}
+
+static void adc_init(Object *obj)
+{
+    ESP32S3ADCState *s = ESP32S3_ADC(obj);
+    memory_region_init_io(&s->sens, obj, &sens_ops, s, "esp32s3.sens",
+                          ESP32S3_SENS_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->sens);
+    qdev_init_gpio_in_named(DEVICE(obj), adc_input, "input-uv",
+                           ESP32S3_ADC_UNITS * ESP32S3_ADC_CHANNELS);
+}
+
+static Property adc_properties[] = {
+    DEFINE_PROP_STRING("initial-uv", ESP32S3ADCState, initial_uv),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void adc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = adc_realize;
+    device_class_set_props(dc, adc_properties);
+    RESETTABLE_CLASS(klass)->phases.hold = adc_reset_hold;
+}
+
+static const TypeInfo adc_info = {
+    .name = TYPE_ESP32S3_ADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3ADCState),
+    .instance_init = adc_init,
+    .class_init = adc_class_init,
+};
+
+static void adc_register_types(void)
+{
+    type_register_static(&adc_info);
+}
+
+type_init(adc_register_types)
