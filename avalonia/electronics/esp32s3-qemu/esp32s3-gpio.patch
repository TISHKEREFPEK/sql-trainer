@@ -29,2 +157,158 @@ static void esp32s3_gpio_init(Object *obj)
-/* If we need to override any function from the parent (reset, realize, ...), it shall be done
- * in this class_init function */
+static uint64_t gpio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3GPIOState *s = opaque;
+    int index;
+    switch (addr) {
+    case 0x04: return (uint32_t)s->output;
+    case 0x10: return s->output >> 32;
+    case 0x20: return (uint32_t)s->output_enable;
+    case 0x2c: return s->output_enable >> 32;
+    case 0x38: return s->strap_mode;
+    case 0x3c: return (uint32_t)s->input;
+    case 0x40: return s->input >> 32;
+    case 0x44: return (uint32_t)s->status;
+    case 0x50: return s->status >> 32;
+    case 0x5c: return (uint32_t)(s->status & s->irq_enabled);
+    case 0x68: return (s->status & s->irq_enabled) >> 32;
+    case 0x14c: return (uint32_t)s->status;
+    case 0x150: return s->status >> 32;
+    }
+    index = register_index(addr, GPIO_PIN0, ESP32S3_GPIO_PADS);
+    if (valid_pad(index)) {
+        return s->pin_cfg[index];
+    }
+    index = register_index(addr, GPIO_FUNC0_IN, ESP32S3_GPIO_MATRIX_INPUTS);
+    if (index >= 0) {
+        return s->matrix_in[index];
+    }
+    index = register_index(addr, GPIO_FUNC0_OUT, ESP32S3_GPIO_PADS);
+    return valid_pad(index) ? s->matrix_out[index] : 0;
+}
+
+static void gpio_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3GPIOState *s = opaque;
+    uint64_t low = (uint32_t)value & (uint32_t)GPIO_VALID_MASK;
+    uint64_t high = (value << 32) & GPIO_VALID_MASK;
+    uint64_t previous_output = s->output;
+    uint64_t previous_enable = s->output_enable;
+    int index;
+    switch (addr) {
+    case 0x04: s->output = (s->output & ~UINT64_C(0xffffffff)) | low; break;
+    case 0x08: s->output |= low; break;
+    case 0x0c: s->output &= ~low; break;
+    case 0x10: s->output = (uint32_t)s->output | high; break;
+    case 0x14: s->output |= high; break;
+    case 0x18: s->output &= ~high; break;
+    case 0x20: s->output_enable = (s->output_enable & ~UINT64_C(0xffffffff)) | low; break;
+    case 0x24: s->output_enable |= low; break;
+    case 0x28: s->output_enable &= ~low; break;
+    case 0x2c: s->output_enable = (uint32_t)s->output_enable | high; break;
+    case 0x30: s->output_enable |= high; break;
+    case 0x34: s->output_enable &= ~high; break;
+    case 0x48: s->status |= low; break;
+    case 0x54: s->status |= high; break;
+    case 0x4c:
+    case 0x58: {
+        uint64_t cleared = addr == 0x4c ? low : high;
+        s->status &= ~cleared;
+        refresh_pads(s, cleared & s->irq_enabled);
+        return;
+    }
+    default:
+        index = register_index(addr, GPIO_PIN0, ESP32S3_GPIO_PADS);
+        if (valid_pad(index)) {
+            uint64_t bit = BIT_ULL(index);
+            s->pin_cfg[index] = value & MAKE_64BIT_MASK(0, 18);
+            s->irq_enabled &= ~bit;
+            if (value & GPIO_PIN_INT_ENABLE) {
+                s->irq_enabled |= bit;
+            }
+            refresh_pads(s, bit);
+            return;
+        }
+        index = register_index(addr, GPIO_FUNC0_IN, ESP32S3_GPIO_MATRIX_INPUTS);
+        if (index >= 0) {
+            s->matrix_in[index] = value & 0xff;
+            return;
+        }
+        index = register_index(addr, GPIO_FUNC0_OUT, ESP32S3_GPIO_PADS);
+        if (valid_pad(index)) {
+            s->matrix_out[index] = value & 0xfff;
+            refresh_pads(s, BIT_ULL(index));
+        }
+        return;
+    }
+    refresh_pads(s, (s->output ^ previous_output) |
+                   (s->output_enable ^ previous_enable));
+}
+
+static uint64_t iomux_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3GPIOState *s = opaque;
+    int pin = register_index(addr, GPIO_MUX_PIN0, ESP32S3_GPIO_PADS);
+    return valid_pad(pin) ? s->iomux[pin] : 0;
+}
+
+static void iomux_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3GPIOState *s = opaque;
+    int pin = register_index(addr, GPIO_MUX_PIN0, ESP32S3_GPIO_PADS);
+    if (valid_pad(pin)) {
+        s->iomux[pin] = value & 0x7fff;
+        refresh_pads(s, BIT_ULL(pin));
+    }
+}
+
+static const MemoryRegionOps gpio_ops = {
+    .read = gpio_read,
+    .write = gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps iomux_ops = {
+    .read = iomux_read,
+    .write = iomux_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void gpio_reset_hold(Object *object, ResetType type)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(object);
+    s->output = 0;
+    s->output_enable = 0;
+    s->input = 0;
+    s->status = 0;
+    s->irq_enabled = 0;
+    memset(s->pin_cfg, 0, sizeof(s->pin_cfg));
+    memset(s->iomux, 0, sizeof(s->iomux));
+    memset(s->matrix_in, 0, sizeof(s->matrix_in));
+    for (int pin = 0; pin < ESP32S3_GPIO_PADS; pin++) {
+        s->matrix_out[pin] = GPIO_MATRIX_LATCH;
+    }
+    refresh_pads(s, GPIO_VALID_MASK);
+}
+
+static void esp32s3_gpio_init(Object *object)
+{
+    ESP32S3GPIOState *s = ESP32S3_GPIO(object);
+    SysBusDevice *bus = SYS_BUS_DEVICE(object);
+    memset(s->external, -1, sizeof(s->external));
+    memory_region_init_io(&s->gpio_mmio, object, &gpio_ops, s, "esp32s3.gpio", 0x1000);
+    memory_region_init_io(&s->iomux_mmio, object, &iomux_ops, s, "esp32s3.iomux", 0x1000);
+    sysbus_init_mmio(bus, &s->gpio_mmio);
+    sysbus_init_mmio(bus, &s->iomux_mmio);
+    sysbus_init_irq(bus, &s->irq);
+    qdev_init_gpio_in_named(DEVICE(s), gpio_input, "pad-in", ESP32S3_GPIO_PADS);
+    qdev_init_gpio_out_named(DEVICE(s), s->pad_level, "pad-level", ESP32S3_GPIO_PADS);
+    qdev_init_gpio_out_named(DEVICE(s), s->pad_driven, "pad-driven", ESP32S3_GPIO_PADS);
+}
+
+static Property gpio_properties[] = {
+    DEFINE_PROP_UINT32("strap_mode", ESP32S3GPIOState, strap_mode,
+                       ESP32S3_STRAP_MODE_FLASH_BOOT),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
