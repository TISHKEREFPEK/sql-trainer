diff --git a/hw/i2c/esp32s3_i2c.c b/hw/i2c/esp32s3_i2c.c
new file mode 100644
index 0000000..b7bdc7e
--- /dev/null
+++ b/hw/i2c/esp32s3_i2c.c
@@ -0,0 +1,418 @@
+/*
+ * ESP32-S3 I2C master controller.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/esp32s3_i2c.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+#include "qemu/bitops.h"
+#include "qemu/cutils.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "sysemu/runstate.h"
+
+enum {
+    SCL_LOW = 0x00, CONTROL = 0x04, STATUS = 0x08, FIFO_CONFIG = 0x18, DATA = 0x1c,
+    INT_RAW = 0x20, INT_CLEAR = 0x24, INT_ENABLE = 0x28, INT_STATUS = 0x2c,
+    SCL_HIGH = 0x38, SCL_CLOCK = 0x54, COMMAND = 0x58, BUS_CLEAR = 0x80,
+};
+
+enum {
+    OP_WRITE = 1, OP_STOP = 2, OP_READ = 3, OP_END = 4, OP_RESTART = 6,
+};
+
+#define MASTER BIT(4)
+#define TRANS_START BIT(5)
+#define FSM_RESET BIT(10)
+#define CONF_UPDATE BIT(11)
+#define BUS_BUSY BIT(4)
+#define NONFIFO BIT(10)
+#define RESET_RX BIT(12)
+#define RESET_TX BIT(13)
+#define RX_OVERFLOW BIT(2)
+#define END_DETECT BIT(3)
+#define COMPLETE BIT(7)
+#define TIMEOUT BIT(8)
+#define NACK BIT(10)
+#define TX_OVERFLOW BIT(11)
+#define CMD_ACK_CHECK BIT(8)
+#define CMD_ACK_EXPECT_NACK BIT(9)
+#define CMD_READ_NACK BIT(10)
+#define CMD_DONE BIT(31)
+#define COMMAND_COUNT 8
+#define FIFO_LENGTH 32
+
+static void update_irq(ESP32S3I2CState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[INT_RAW / 4] & s->regs[INT_ENABLE / 4]));
+}
+
+static void stop_bus(ESP32S3I2CState *s)
+{
+    i2c_end_transfer(s->bus);
+    s->addressed = false;
+    s->start_pending = false;
+    s->receive = false;
+    if (s->classroom_host) {
+        s->epoch++;
+        s->pending = false;
+    }
+}
+
+static bool write_byte(ESP32S3I2CState *s, uint8_t byte)
+{
+    if (s->start_pending) {
+        uint8_t address = byte >> 1;
+
+        /* The QEMU bus keeps its target on a same-address repeated START. */
+        if (s->addressed && address != s->address) {
+            i2c_end_transfer(s->bus);
+        }
+        s->start_pending = false;
+        s->receive = byte & 1;
+        s->address = address;
+        s->addressed = i2c_start_transfer(s->bus, address, s->receive) == 0;
+        return s->addressed;
+    }
+    return s->addressed && !s->receive && i2c_send(s->bus, byte) == 0;
+}
+
+static uint32_t write_command(ESP32S3I2CState *s, uint32_t cmd, unsigned count)
+{
+    bool expected_ack = !(cmd & CMD_ACK_EXPECT_NACK);
+
+    if (count > fifo8_num_used(&s->tx)) {
+        return TIMEOUT;
+    }
+    for (unsigned i = 0; i < count; i++) {
+        bool ack = write_byte(s, fifo8_pop(&s->tx));
+
+        if ((cmd & CMD_ACK_CHECK) && ack != expected_ack) {
+            return NACK;
+        }
+    }
+    return 0;
+}
+
+static uint32_t read_command(ESP32S3I2CState *s, uint32_t cmd, unsigned count)
+{
+    if (!s->addressed || s->start_pending || !s->receive) {
+        return TIMEOUT;
+    }
+    if (count > fifo8_num_free(&s->rx)) {
+        return TIMEOUT | RX_OVERFLOW;
+    }
+    for (unsigned i = 0; i < count; i++) {
+        fifo8_push(&s->rx, i2c_recv(s->bus));
+    }
+    if (count && (cmd & CMD_READ_NACK)) {
+        i2c_nack(s->bus);
+    }
+    return 0;
+}
+
+static void run_commands(ESP32S3I2CState *s)
+{
+    uint32_t *program = &s->regs[COMMAND / 4];
+    uint32_t event = 0;
+
+    for (int i = 0; i < COMMAND_COUNT && !event; i++) {
+        uint32_t cmd = program[i];
+        unsigned count = extract32(cmd, 0, 8);
+
+        switch (extract32(cmd, 11, 3)) {
+        case OP_RESTART:
+            s->start_pending = true;
+            break;
+        case OP_WRITE:
+            event = write_command(s, cmd, count);
+            break;
+        case OP_READ:
+            event = read_command(s, cmd, count);
+            break;
+        case OP_STOP:
+            stop_bus(s);
+            event = COMPLETE;
+            break;
+        case OP_END:
+            event = END_DETECT;
+            break;
+        default:
+            event = TIMEOUT;
+            break;
+        }
+        program[i] |= CMD_DONE;
+    }
+    if (!event || (event & (NACK | TIMEOUT))) {
+        stop_bus(s);
+    }
+    s->regs[INT_RAW / 4] |= event ? event : TIMEOUT;
+    update_irq(s);
+}
+
+static unsigned scl_frequency(ESP32S3I2CState *s)
+{
+    uint32_t low = s->regs[SCL_LOW / 4];
+    uint32_t high = s->regs[SCL_HIGH / 4];
+    uint32_t clock = s->regs[SCL_CLOCK / 4];
+    unsigned clocks = extract32(low, 0, 9) + 1 + extract32(high, 0, 9) +
+                      extract32(high, 9, 7);
+    unsigned source_hz = clock & BIT(20) ? 20000000 : 40000000;
+
+    return source_hz / ((extract32(clock, 0, 8) + 1) * clocks);
+}
+
+static char *classroom_request(Object *obj, Error **errp)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+    uint8_t tx[FIFO_LENGTH];
+    unsigned count;
+    unsigned free_rx;
+    int scl, sda;
+    GString *wire;
+
+    if (!s->pending || runstate_get() != RUN_STATE_PAUSED) {
+        return g_strdup("-");
+    }
+    scl = esp32s3_gpio_open_drain_route(s->gpio, 89 + 2 * s->port);
+    sda = esp32s3_gpio_open_drain_route(s->gpio, 90 + 2 * s->port);
+    count = fifo8_peek_buf(&s->tx, tx, fifo8_num_used(&s->tx));
+    free_rx = fifo8_num_free(&s->rx);
+    wire = g_string_new(NULL);
+    g_string_append_printf(wire, "%u:%u:%" PRId64 ":%d:%d:%u:%u:",
+                           s->sequence, s->epoch, s->captured_ns,
+                           sda, scl, scl_frequency(s), free_rx);
+    for (int i = 0; i < COMMAND_COUNT; i++) {
+        g_string_append_printf(wire, "%08x", s->regs[COMMAND / 4 + i]);
+    }
+    g_string_append_c(wire, ':');
+    for (unsigned i = 0; i < count; i++) {
+        g_string_append_printf(wire, "%02x", tx[i]);
+    }
+    return g_string_free(wire, false);
+}
+
+static void classroom_reply(Object *obj, const char *wire, Error **errp)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+    g_auto(GStrv) fields = g_strsplit(wire, ":", 7);
+    unsigned seq, event, commands, tx, busy;
+    uint8_t rx[FIFO_LENGTH];
+    size_t hex_len;
+
+    if (!s->pending || g_strv_length(fields) != 6 ||
+        qemu_strtoui(fields[0], NULL, 10, &seq) < 0 || seq != s->sequence ||
+        qemu_strtoui(fields[1], NULL, 10, &event) < 0 ||
+        (event != NACK && event != COMPLETE && event != END_DETECT &&
+         event != TIMEOUT && event != (TIMEOUT | RX_OVERFLOW)) ||
+        qemu_strtoui(fields[2], NULL, 10, &commands) < 0 ||
+        commands < 1 || commands > COMMAND_COUNT ||
+        qemu_strtoui(fields[3], NULL, 10, &tx) < 0 ||
+        tx > fifo8_num_used(&s->tx) ||
+        qemu_strtoui(fields[4], NULL, 10, &busy) < 0 ||
+        busy > 1 || (busy && event != END_DETECT)) {
+        error_setg(errp, "Invalid Classroom I2C result");
+        return;
+    }
+    hex_len = strlen(fields[5]);
+    if (hex_len % 2 || hex_len / 2 > fifo8_num_free(&s->rx)) {
+        error_setg(errp, "Classroom I2C receive FIFO overflow");
+        return;
+    }
+    for (size_t i = 0; i < hex_len / 2; i++) {
+        int high = g_ascii_xdigit_value(fields[5][i * 2]);
+        int low = g_ascii_xdigit_value(fields[5][i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            error_setg(errp, "Invalid Classroom I2C receive byte");
+            return;
+        }
+        rx[i] = high * 16 + low;
+    }
+    fifo8_drop(&s->tx, tx);
+    for (size_t i = 0; i < hex_len / 2; i++) {
+        fifo8_push(&s->rx, rx[i]);
+    }
+    for (unsigned i = 0; i < commands; i++) {
+        s->regs[COMMAND / 4 + i] |= CMD_DONE;
+    }
+    s->addressed = busy;
+    s->pending = false;
+    s->regs[INT_RAW / 4] |= event;
+    update_irq(s);
+}
+
+static bool classroom_pending(Object *obj, Error **errp)
+{
+    return ESP32S3_I2C(obj)->pending;
+}
+
+static uint64_t i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32S3I2CState *s = opaque;
+
+    switch (addr) {
+    case STATUS:
+        return ((s->addressed || s->start_pending || s->pending) ? BUS_BUSY : 0) |
+               (fifo8_num_used(&s->rx) << 8) | (fifo8_num_used(&s->tx) << 18);
+    case DATA:
+        return fifo8_is_empty(&s->rx) ? 0 : fifo8_pop(&s->rx);
+    case INT_STATUS:
+        return s->regs[INT_RAW / 4] & s->regs[INT_ENABLE / 4];
+    default:
+        return s->regs[addr / 4];
+    }
+}
+
+static void i2c_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ESP32S3I2CState *s = opaque;
+    uint32_t *reg = &s->regs[addr / 4];
+
+    switch (addr) {
+    case CONTROL:
+        *reg = value & ~(TRANS_START | FSM_RESET | CONF_UPDATE);
+        if (value & FSM_RESET) {
+            stop_bus(s);
+        }
+        if (value & TRANS_START) {
+            if ((value & MASTER) && !(s->regs[FIFO_CONFIG / 4] & NONFIFO)) {
+                if (!s->classroom_host) {
+                    run_commands(s);
+                } else if (!s->pending) {
+                    s->pending = true;
+                    s->sequence++;
+                    s->captured_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+                    vm_stop(RUN_STATE_PAUSED);
+                }
+            } else {
+                s->regs[INT_RAW / 4] |= TIMEOUT;
+                update_irq(s);
+            }
+        }
+        break;
+    case FIFO_CONFIG:
+        *reg = value & ~(RESET_RX | RESET_TX);
+        if (value & RESET_RX) {
+            fifo8_reset(&s->rx);
+        }
+        if (value & RESET_TX) {
+            fifo8_reset(&s->tx);
+        }
+        break;
+    case DATA:
+        if (fifo8_is_full(&s->tx)) {
+            s->regs[INT_RAW / 4] |= TX_OVERFLOW;
+            update_irq(s);
+        } else {
+            fifo8_push(&s->tx, value);
+        }
+        break;
+    case INT_CLEAR:
+        s->regs[INT_RAW / 4] &= ~value;
+        update_irq(s);
+        break;
+    case INT_ENABLE:
+        *reg = value;
+        update_irq(s);
+        break;
+    case INT_RAW:
+    case INT_STATUS:
+    case STATUS:
+        break;
+    case BUS_CLEAR:
+        *reg = value & ~BIT(0);
+        if (value & BIT(0)) {
+            stop_bus(s);
+        }
+        break;
+    default:
+        *reg = addr >= COMMAND && addr < COMMAND + 4 * COMMAND_COUNT
+            ? value & ~CMD_DONE : value;
+        break;
+    }
+}
+
+static const MemoryRegionOps ops = {
+    .read = i2c_read,
+    .write = i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void i2c_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+
+    stop_bus(s);
+    fifo8_reset(&s->rx);
+    fifo8_reset(&s->tx);
+    memset(s->regs, 0, sizeof(s->regs));
+    update_irq(s);
+}
+
+static void i2c_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(dev);
+    g_autofree char *bus_name = g_strdup_printf("esp32s3-i2c%u", s->port);
+
+    s->bus = i2c_init_bus(dev, bus_name);
+}
+
+static void i2c_init(Object *obj)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+    SysBusDevice *busdev = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &ops, s, TYPE_ESP32S3_I2C,
+                          ESP32S3_I2C_REGISTER_SIZE);
+    sysbus_init_mmio(busdev, &s->mmio);
+    sysbus_init_irq(busdev, &s->irq);
+    fifo8_create(&s->rx, FIFO_LENGTH);
+    fifo8_create(&s->tx, FIFO_LENGTH);
+}
+
+static void i2c_finalize(Object *obj)
+{
+    ESP32S3I2CState *s = ESP32S3_I2C(obj);
+
+    fifo8_destroy(&s->tx);
+    fifo8_destroy(&s->rx);
+}
+
+static Property i2c_properties[] = {
+    DEFINE_PROP_UINT8("port", ESP32S3I2CState, port, 0),
+    DEFINE_PROP_BOOL("classroom-host", ESP32S3I2CState, classroom_host, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void i2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = i2c_realize;
+    device_class_set_props(dc, i2c_properties);
+    RESETTABLE_CLASS(klass)->phases.hold = i2c_reset_hold;
+    object_class_property_add_str(klass, "classroom-request", classroom_request, NULL);
+    object_class_property_add_str(klass, "classroom-reply", NULL, classroom_reply);
+    object_class_property_add_bool(klass, "classroom-pending", classroom_pending, NULL);
+}
+
+static const TypeInfo i2c_info = {
+    .name = TYPE_ESP32S3_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3I2CState),
+    .instance_init = i2c_init,
+    .instance_finalize = i2c_finalize,
+    .class_init = i2c_class_init,
+};
+
+static void i2c_register_types(void)
+{
+    type_register_static(&i2c_info);
+}
+
+type_init(i2c_register_types)
