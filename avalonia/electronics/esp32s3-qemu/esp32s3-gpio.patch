+/*
+ * Digital pad path from ESP32-S3 TRM chapter 6: the GPIO latch is routed
+ * through matrix source 256 and IO MUX function 1. Other matrix sources
+ * retain their configuration for a peripheral model to consume.
+ */
+#define GPIO_VALID_MASK (MAKE_64BIT_MASK(0, 49) & ~MAKE_64BIT_MASK(22, 4))
+#define GPIO_PIN0 0x074
+#define GPIO_FUNC0_IN 0x154
+#define GPIO_FUNC0_OUT 0x554
+#define GPIO_MUX_PIN0 0x004
+#define GPIO_MATRIX_LATCH 256
+#define GPIO_FUN_GPIO 1
+#define GPIO_FUN_PD BIT(7)
+#define GPIO_FUN_PU BIT(8)
+#define GPIO_FUN_IE BIT(9)
+#define GPIO_PAD_DRIVER BIT(2)
+#define GPIO_PIN_INT_ENABLE BIT(13)
+
+typedef enum {
+    GPIO_INT_RISING = 1,
+    GPIO_INT_FALLING,
+    GPIO_INT_ANY_EDGE,
+    GPIO_INT_LOW,
+    GPIO_INT_HIGH,
+} Esp32S3GpioInterrupt;
+
+static bool valid_pad(int pin)
+{
+    return pin >= 0 && pin < ESP32S3_GPIO_PADS &&
+           (GPIO_VALID_MASK & BIT_ULL(pin));
+}
+
+static void update_interrupt(ESP32S3GPIOState *s)
+{
+    qemu_set_irq(s->irq, (s->status & s->irq_enabled) != 0);
+}
+
+static void refresh_pad(ESP32S3GPIOState *s, unsigned pin)
+{
+    uint64_t bit = BIT_ULL(pin);
+    uint32_t mux = s->iomux[pin];
+    uint32_t config = s->pin_cfg[pin];
+    uint32_t source = s->matrix_out[pin];
+    bool latch = ((s->output & bit) != 0) ^ (extract32(source, 9, 1) != 0);
+    bool enabled = ((s->output_enable & bit) != 0) ^
+                   (extract32(source, 11, 1) != 0);
+    bool driven = extract32(mux, 12, 3) == GPIO_FUN_GPIO &&
+                  extract32(source, 0, 9) == GPIO_MATRIX_LATCH &&
+                  enabled && !(latch && (config & GPIO_PAD_DRIVER));
+    bool level = driven ? latch : s->external[pin] >= 0 ? s->external[pin] :
+                 (mux & GPIO_FUN_PU) && !(mux & GPIO_FUN_PD);
+    bool was_input_high = (s->input & bit) != 0;
+    bool input_high = level && (mux & GPIO_FUN_IE);
+
+    if (((s->levels & bit) != 0) != level) {
+        s->levels ^= bit;
+        qemu_set_irq(s->pad_level[pin], level);
+    }
+    if (((s->driven & bit) != 0) != driven) {
+        s->driven ^= bit;
+        qemu_set_irq(s->pad_driven[pin], driven);
+    }
+    if (input_high != was_input_high) {
+        s->input ^= bit;
+    }
+    if ((s->irq_enabled & bit) && (mux & GPIO_FUN_IE)) {
+        switch (extract32(config, 7, 3)) {
+        case GPIO_INT_RISING:
+            if (!was_input_high && input_high) {
+                s->status |= bit;
+            }
+            break;
+        case GPIO_INT_FALLING:
+            if (was_input_high && !input_high) {
+                s->status |= bit;
+            }
+            break;
+        case GPIO_INT_ANY_EDGE:
+            if (was_input_high != input_high) {
+                s->status |= bit;
+            }
+            break;
+        case GPIO_INT_LOW:
+            if (!input_high) {
+                s->status |= bit;
+            }
+            break;
+        case GPIO_INT_HIGH:
+            if (input_high) {
+                s->status |= bit;
+            }
+            break;
+        }
+    }
+}
+
+static void refresh_pads(ESP32S3GPIOState *s, uint64_t pins)
+{
+    pins &= GPIO_VALID_MASK;
+    while (pins) {
+        unsigned pin = ctz64(pins);
+        refresh_pad(s, pin);
+        pins &= pins - 1;
+    }
+    update_interrupt(s);
+}
+
+static void gpio_input(void *opaque, int pin, int level)
+{
+    ESP32S3GPIOState *s = opaque;
+    if (valid_pad(pin) && level >= -1 && level <= 1) {
+        s->external[pin] = level;
+        refresh_pads(s, BIT_ULL(pin));
+    }
+}
+
+static int register_index(hwaddr addr, hwaddr base, int count)
+{
+    if (addr < base || addr >= base + count * 4) {
+        return -1;
+    }
+    return (addr - base) / 4;
+}
