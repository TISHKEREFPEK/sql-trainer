+#include "qemu/base64.h"
@@ -345,0 +347,107 @@ static void qtest_install_gpio_out_intercept(DeviceState *dev, const char *name,
+static bool qtest_classroom_uart(CharBackend *chr, gchar **words)
+{
+    static const char *const ports[] = {
+        "classroom-uart0", "classroom-uart1", "classroom-uart2",
+    };
+    bool read = !strcmp(words[0], "classroom_uart_read");
+    bool write = !strcmp(words[0], "classroom_uart_write");
+    Chardev *port = NULL;
+
+    if (!strcmp(words[0], "classroom_uart_version")) {
+        qtest_send_prefix(chr);
+        qtest_send(chr, "OK 1\n");
+        return true;
+    }
+    if (!read && !write) {
+        return false;
+    }
+
+    if (words[1] && strlen(words[1]) == 1 &&
+        words[1][0] >= '0' && words[1][0] <= '2') {
+        port = qemu_chr_find(ports[words[1][0] - '0']);
+    }
+    qtest_send_prefix(chr);
+    if (!port || !CHARDEV_IS_RINGBUF(port)) {
+        qtest_send(chr, "FAIL Unknown classroom UART\n");
+    } else if (read) {
+        uint8_t bytes[4096];
+        uint64_t dropped;
+        int count = qemu_chr_ringbuf_read(port, bytes, sizeof(bytes), &dropped);
+        g_autofree char *encoded = count ? g_base64_encode(bytes, count) : NULL;
+
+        qtest_sendf(chr, "OK %" PRIu64 " %s\n", dropped, encoded ? encoded : "-");
+    } else {
+        gsize size = 0;
+        g_autofree uint8_t *bytes = words[2] && strlen(words[2]) <= 172
+            ? qbase64_decode(words[2], -1, &size, NULL) : NULL;
+        if (!bytes || !size || size > 128) {
+            qtest_send(chr, "FAIL Invalid classroom UART data\n");
+        } else {
+            int count = MIN((int)size, qemu_chr_be_can_write(port));
+
+            if (count > 0) {
+                qemu_chr_be_write(port, bytes, count);
+            }
+            qtest_sendf(chr, "OK %d\n", count);
+        }
+    }
+    return true;
+}
+
+static bool qtest_classroom_i2c(CharBackend *chr, gchar **words)
+{
+    bool poll = !strcmp(words[0], "classroom_i2c_poll");
+    bool reply = !strcmp(words[0], "classroom_i2c_reply");
+    bool version = !strcmp(words[0], "classroom_i2c_version");
+    bool clock = !strcmp(words[0], "classroom_i2c_clock");
+    Object *ports[2];
+    Object *port;
+    Error *err = NULL;
+
+    if (!poll && !reply && !version && !clock) {
+        return false;
+    }
+    ports[0] = object_resolve_path("/machine/soc/i2c0", NULL);
+    ports[1] = object_resolve_path("/machine/soc/i2c1", NULL);
+    qtest_send_prefix(chr);
+    if (!ports[0] || !ports[1] ||
+        !object_property_find(ports[0], "classroom-request") ||
+        !object_property_find(ports[1], "classroom-request")) {
+        qtest_send(chr, "FAIL Missing Classroom I2C\n");
+        return true;
+    }
+    if (version) {
+        qtest_send(chr, "OK 1\n");
+        return true;
+    }
+    if (clock) {
+        qtest_sendf(chr, "OK %" PRId64 "\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        return true;
+    }
+    if (!words[1] || (strcmp(words[1], "0") && strcmp(words[1], "1"))) {
+        qtest_send(chr, "FAIL Invalid Classroom I2C port\n");
+        return true;
+    }
+    port = ports[words[1][0] - '0'];
+    if (poll) {
+        g_autofree char *request =
+            object_property_get_str(port, "classroom-request", &err);
+        if (!err) {
+            qtest_sendf(chr, "OK %s\n", request);
+            return true;
+        }
+    } else if (runstate_get() == RUN_STATE_PAUSED && words[2] &&
+               strlen(words[2]) < 128 &&
+               object_property_set_str(port, "classroom-reply", words[2], &err)) {
+        if (!object_property_get_bool(ports[0], "classroom-pending", &error_abort) &&
+            !object_property_get_bool(ports[1], "classroom-pending", &error_abort)) {
+            vm_start();
+        }
+        qtest_send(chr, "OK\n");
+        return true;
+    }
+    error_free(err);
+    qtest_send(chr, "FAIL Invalid Classroom I2C exchange\n");
+    return true;
+}
+
