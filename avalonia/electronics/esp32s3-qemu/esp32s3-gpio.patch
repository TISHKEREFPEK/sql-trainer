+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_I2C_ESP32S3_I2C_H
+#define HW_I2C_ESP32S3_I2C_H
+
+#include "hw/sysbus.h"
+#include "hw/i2c/i2c.h"
+#include "hw/gpio/esp32s3_gpio.h"
+#include "qemu/fifo8.h"
+
+#define TYPE_ESP32S3_I2C "esp32s3.i2c"
+#define ESP32S3_I2C_REGISTER_SIZE 0x100
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3I2CState, ESP32S3_I2C)
+
+struct ESP32S3I2CState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    I2CBus *bus;
+    ESP32S3GPIOState *gpio;
+    qemu_irq irq;
+    Fifo8 tx;
+    Fifo8 rx;
+    uint32_t regs[ESP32S3_I2C_REGISTER_SIZE / 4];
+    uint8_t port;
+    uint8_t address;
+    bool addressed;
+    bool start_pending;
+    bool receive;
+    bool classroom_host;
+    bool pending;
+    uint32_t epoch;
+    uint32_t sequence;
+    int64_t captured_ns;
+};
+
+#endif
